{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "记者选拔回避与复核领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ENTRY_ACCEPTED",
        "RECUSAL_DECLARED",
        "SCORE_SUBMITTED",
        "INCIDENT_CONFIRMED",
        "DECISION_FINALIZED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "candidate_entry",
        "judging_assignment",
        "score_sheet",
        "appeal_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
